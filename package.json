{
  "name": "fund-recommender",
  "version": "1.2.0",
  "description": "支付宝基金推荐助手",
  "type": "module",
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.cjs",
    "test": "vitest run && node --test \"server/__tests__/*.test.cjs\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:server:coverage",
    "test:server": "node --test \"server/__tests__/*.test.cjs\"",
    "test:server:coverage": "c8 --reporter=text node --test \"server/__tests__/*.test.cjs\"",
    "lint": "eslint src/ server/",
    "lint:fix": "eslint src/ server/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "generate-alipay-keys": "node scripts/generate-alipay-keys.cjs",
    "test-alipay": "node scripts/test-alipay.cjs",
    "cap:build": "CAPACITOR=true vite build --mode capacitor && npx cap sync android",
    "cap:apk": "cd android && JAVA_HOME=\"C:/Program Files/Android/Android Studio/jbr\" ./gradlew assembleDebug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@anthropic-ai/sdk": "^0.105.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "alipay-sdk": "^4.14.0",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "gsap": "^3.15.0",
    "helmet": "^8.2.0",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^7.4.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "remark-gfm": "^4.0.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.9"
  }
}
