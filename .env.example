# ============================================================
# 基金数据看板 (Fund Recommender) 环境变量配置
# 复制此文件为 .env 并填入真实值后运行: npm run server
# ============================================================

# ---- 服务器 ----
PORT=3003                            # 后端监听端口
NODE_ENV=development                 # production 禁用 mock auth

# ---- JWT 密钥 ----
# 生成命令: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-random-string-at-least-32-chars

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:8866,http://localhost:5173,http://localhost:5174

# ---- Mock 登录（仅开发） ----
ENABLE_MOCK_AUTH=false

# ---- PostgreSQL ----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=fund_recommender
PG_USER=your_db_user
PG_PASSWORD=your_db_password

# ---- 支付宝 OAuth（可选） ----
# 1. 登录 https://open.alipay.com 创建应用获取 APPID
# 2. 运行 node scripts/generate-alipay-keys.cjs 生成密钥对
# 3. 上传应用公钥到支付宝开放平台，获取支付宝公钥
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=keys/alipay_private_key.pem
# ALIPAY_PUBLIC_KEY=keys/alipay_public_key_from_alipay.pem
# ALIPAY_RETURN_URL=http://your-domain/api/auth/alipay/callback
# ALIPAY_NOTIFY_URL=http://your-domain/api/subscription/notify

# ---- AI 助手 (Anthropic Claude 直连) ----
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- AI 投资助手 (OpenAI 兼容网关) ----
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your_key
# OPENAI_MODELS=gpt-4o,gpt-4o-mini

# ---- Capacitor APK 构建 ----
# VITE_API_HOST=your-server-ip