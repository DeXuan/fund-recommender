JWT_SECRET=generate-a-random-string-at-least-32-chars
# Set to 'true' only in development to enable mock Alipay login (NEVER in production)
ENABLE_MOCK_AUTH=false

# 支付宝OAuth配置
# 1. 登录支付宝开放平台: https://open.alipay.com
# 2. 创建应用并获取APPID
# 3. 运行 node scripts/generate-alipay-keys.cjs 生成密钥对
# 4. 上传应用公钥到支付宝开放平台，获取支付宝公钥
# 5. 配置以下环境变量
ALIPAY_APP_ID=2021006159645339
# 应用私钥（支持文件路径或直接粘贴私钥内容）
ALIPAY_PRIVATE_KEY=keys/alipay_private_key.pem
# 支付宝公钥（从支付宝开放平台获取，支持文件路径或直接粘贴公钥内容）
ALIPAY_PUBLIC_KEY=keys/alipay_public_key_from_alipay.pem
# 支付宝授权回调地址（必须与支付宝开放平台配置一致）
ALIPAY_RETURN_URL=http://localhost:5174/web/login

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=fund_recommender
PG_USER=your_db_user
PG_PASSWORD=your_db_password
